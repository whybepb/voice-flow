generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  company   String?
  twilioAccountSid  String?
  twilioAuthToken   String?
  twilioPhoneNumber String?
  openaiApiKey      String?
  onboardingComplete Boolean @default(false)
  role      Role     @default(USER)
  agentVoice      String?  @default("cedar")
  agentPrompt     String?  @default("You are the business's AI phone assistant. Help callers clearly, warmly, and efficiently.")
  createdAt DateTime @default(now())
  customers      Customer[]
  campaigns      Campaign[]
  bookings       Booking[]
  callLogs       CallLog[]
  knowledgeDocs  KnowledgeDocument[]
  backgroundJobs BackgroundJob[]
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  appointmentTime DateTime
  service        String?       @default("General Consultation")
  status         BookingStatus @default(PENDING)
  lastCallStatus String?
  createdAt      DateTime      @default(now())
  callLogs       CallLog[]
  @@index([userId])
}

model CallLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  sid         String?  @unique // Twilio Call SID
  callStatus  String
  transcript  String?
  recordingUrl String?
  duration    Int?
  summary     String?  // Post-call AI summary
  sentiment   String?  // Positive, Neutral, Negative, etc.
  actionItems String?  // Extracted action items
  createdAt   DateTime @default(now())
  @@index([userId])
}

model Campaign {
  id          String    @id @default(uuid())
  name        String
  type        String    // e.g., "Confirmation", "Reminder"
  status      String    @default("DRAFT") // DRAFT, RUNNING, COMPLETED, PAUSED
  voiceMode   VoiceMode @default(DEFAULT)
  agentVoiceOverride String?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

// ─── RAG Knowledge Base ─────────────────────────────────────────────

model KnowledgeDocument {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  fileName    String
  fileType    String             // "pdf", "txt"
  fileSize    Int                // bytes
  rawContent  String             // full extracted text
  status      KnowledgeDocStatus @default(PROCESSING)
  chunkCount  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  chunks      KnowledgeChunk[]
  @@index([userId])
}

model KnowledgeChunk {
  id          String            @id @default(uuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content     String
  chunkIndex  Int
  // pgvector column — managed via raw SQL; not directly queryable through Prisma client
  embedding   Unsupported("vector(1536)")
  createdAt   DateTime          @default(now())
  @@index([documentId])
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
}

enum KnowledgeDocStatus {
  PROCESSING
  READY
  FAILED
}

model BackgroundJob {
  id          String          @id @default(uuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        BackgroundJobType
  status      BackgroundJobStatus @default(PENDING)
  payload     Json
  attempts    Int             @default(0)
  maxAttempts Int             @default(3)
  runAt       DateTime        @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, runAt])
  @@index([userId, type])
}

enum BackgroundJobType {
  KNOWLEDGE_INGEST
  KNOWLEDGE_REINDEX
  POST_CALL_ANALYSIS
  CAMPAIGN_CALL
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  FAILED
}

enum VoiceMode {
  DEFAULT
  PREMIUM
}
