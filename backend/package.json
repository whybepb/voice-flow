{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:integration",
    "test:integration": "NODE_ENV=test MOCK_TWILIO=true MOCK_OPENAI_EMBEDDINGS=true ts-node src/tests/integration/run.ts",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset --force",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate deploy",
    "db:baseline:resolve": "npx prisma migrate resolve --applied 20260302235500_baseline",
    "secrets:encrypt": "ts-node src/scripts/encrypt-existing-secrets.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.6.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "openai": "^6.24.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.22.0",
    "twilio": "^5.12.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
